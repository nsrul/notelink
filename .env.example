# Public client settings. Vite inlines these into production builds.
# `npm run dev` and `npm start` run a local Jazz server and publish its
# address at /api/jazz-config, so these do not steer the local app.
VITE_JAZZ_APP_ID=
VITE_JAZZ_SERVER_URL=https://v2.sync.jazz.tools/

# Server-only. Never prefix these with VITE_.
JAZZ_ADMIN_SECRET=
BACKEND_SECRET=

# Better Auth. Leave unset for local dev: the origin is http://127.0.0.1:8870
# and the secret stays on this machine. Set both, with no trailing slash on
# the URL, when a local auth server has a shared origin.
# Production stores BETTER_AUTH_SECRET as a GitHub Actions secret. CI copies
# it to the Vercel project. Leave BETTER_AUTH_URL empty there.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Better Auth. Leave unset for local dev: the origin is http://127.0.0.1:8870
# and the secret stays on this machine. Set both, with no trailing slash on
# the URL, when a local auth server has a shared origin.
# Configure BETTER_AUTH_SECRET directly in the Vercel project for production
# and preview deployments. Leave BETTER_AUTH_URL empty there.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

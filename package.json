{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8870 --strictPort",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node --experimental-strip-types server/serve.ts",
    "preview": "vite preview --host 127.0.0.1 --port 8870 --strictPort"
  },
  "dependencies": {
    "better-auth": "^1.7.1",
    "highlight.js": "11.12.0",
    "jazz-tools": "2.0.0-alpha.59",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "fake-indexeddb": "6.2.6",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.10"
  },
  "name": "notes",
  "version": "1.0.0",
  "description": "A standalone local-first notes app with rich text, databases, backlinks and graph views."
}
